# Application identity
APP_NAME=refleks-api
APP_ENV=development
APP_VERSION=dev

# HTTP server
APP_PORT=8080
LOG_LEVEL=info
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

# Run sync (Supabase + Cloudflare R2)
# Set to true to enable /v1/runs/sync endpoints.
RUNSYNC_ENABLED=false

# Supabase Postgres connection string.
# Used by benchmarks/leaderboards and run sync metadata (when enabled),
# and by auth stub reachability checks.
# Database schema/tables are expected to be migrated by a separate worker/migration container.
SUPABASE_DB_URL=

# Cloudflare R2 credentials and bucket.
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
R2_RAW_PUBLIC_BUCKET=refleks-raw-public
R2_LAB_PRIVATE_BUCKET=refleks-lab-private
# Optional: if set, raw download URL endpoint returns this direct public URL form.
# Example: https://pub-abc123.r2.dev
R2_RAW_PUBLIC_BASE_URL=
# Used when R2_RAW_PUBLIC_BASE_URL is empty (signed URL fallback).
R2_SIGNED_URL_TTL=15m

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KEY_PREFIX=runs

# Request limits
RUNSYNC_MAX_FILE_BYTES=26214400
RUNSYNC_MAX_BULK_FILES=100
RUNSYNC_MAX_BULK_BYTES=262144000
RUNSYNC_MAX_MISSING_HASHES=1000
